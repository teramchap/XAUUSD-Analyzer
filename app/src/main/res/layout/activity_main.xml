<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="XAUUSD Analyzer" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="نسخه ۲ — تحلیل چندتایم‌فریمی" android:textSize="14sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/price" android:text="XAUUSD  --" android:textSize="29sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/updated" android:text="آخرین بروزرسانی: --" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="WAIT" android:textSize="23sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/analysis" android:text="در انتظار داده..." android:textSize="16sp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/refresh" android:text="بروزرسانی تحلیل" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/settings" android:text="تنظیم منبع قیمت" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="نسخه ۲ هنوز معامله‌ای باز نمی‌کند. برای فید زنده واقعی باید API معتبر XAUUSD تنظیم شود." android:textSize="12sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>